logging {
  level = "info"
}

discovery.kubernetes "pods" {
  role = "pod"

  namespaces {
    own_namespace = true
  }

  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("HOST_NODE_NAME")
  }
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "service"
  }

}

loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

loki.process "pod_logs" {

  stage.static_labels {
    values = {
      project = "memory-steward",
    }
  }

  forward_to = [loki.write.oco.receiver]
}

loki.write "oco" {
  endpoint {
    url = "http://alloy.observability-backend.svc.cluster.local:12348/loki/api/v1/push"
  }
}

prometheus.remote_write "oco" {
  endpoint {
    url = "http://alloy.observability-backend.svc.cluster.local:12347/api/v1/metrics/write"
  }
}

prometheus.scrape "alloy_self" {
  targets = [
    {
      "__address__" = "127.0.0.1:12345",
      "project"     = "memory-steward",
      "namespace"   = "ms",
      "service"     = "alloy",
    },
  ]
  forward_to = [prometheus.remote_write.oco.receiver]
}

prometheus.scrape "qdrant" {
  targets = [
    {
      "__address__" = "qdrant:6333",
      "project"     = "memory-steward",
      "namespace"   = "ms",
      "service"     = "qdrant",
    },
  ]
  forward_to = [prometheus.remote_write.oco.receiver]
}

prometheus.scrape "memory_router" {
  targets = [
    {
      "__address__" = "memory-router:8080",
      "project"     = "memory-steward",
      "namespace"   = "ms",
      "service"     = "memory-router",
    },
  ]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.oco.receiver]
}

prometheus.scrape "memory_steward_mcp" {
  targets = [
    {
      "__address__" = "memory-steward-mcp:8081",
      "project"     = "memory-steward",
      "namespace"   = "ms",
      "service"     = "memory-steward-mcp",
    },
  ]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.oco.receiver]
}

otelcol.receiver.otlp "local" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.batch.oco.input]
    logs    = [otelcol.processor.batch.oco.input]
    traces  = [otelcol.processor.batch.oco.input]
  }
}

otelcol.processor.batch "oco" {
  timeout = "5s"

  output {
    metrics = [otelcol.exporter.otlp.oco.input]
    logs    = [otelcol.exporter.otlp.oco.input]
    traces  = [otelcol.exporter.otlp.oco.input]
  }
}

otelcol.exporter.otlp "oco" {
  client {
    endpoint = "alloy.observability-backend.svc.cluster.local:4317"
    tls {
      insecure = true
    }
  }
}
